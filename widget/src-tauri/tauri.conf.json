{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avis",
  "version": "0.17.0",
  "identifier": "studio.quintech.oficina",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "principal",
        "title": "Avis",
        "width": 400,
        "height": 620,
        "minWidth": 320,
        "minHeight": 56,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Quintech Studio",
    "copyright": "© 2026 Quintech Studio",
    "category": "Productivity",
    "shortDescription": "Avis de Quintech: tus sesiones de Claude Code como Avis en un tablero",
    "longDescription": "Widget de escritorio que muestra las sesiones de Claude Code abiertas en la máquina y sus subagentes, con las preguntas que esperan respuesta.",
    "windows": {
      "wix": {
        "language": "es-ES",
        "upgradeCode": "f09265d0-6c0d-5936-8e38-12dc2921e98f"
      },
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
